# ===== zichan-manager MCP Server 配置 =====
# 后端 API 地址：
#   生产容器内: http://backend:8000
#   本机调试:   http://192.168.10.241:8000
BACKEND_URL=http://backend:8000

# agent 服务账号（由管理员在 /api/users 创建，role=user 即可）
AGENT_USERNAME=agent
AGENT_PASSWORD=请填写随机强密码

# MCP HTTP 鉴权令牌（外部 agent 客户端连接时需要，生成方式：openssl rand -hex 32）
MCP_BEARER_TOKEN=请生成随机令牌

# HTTP 监听
HOST=0.0.0.0
PORT=8090

# stdio=本机调试 / http=生产（远程 agent 连接）
MCP_TRANSPORT=http
